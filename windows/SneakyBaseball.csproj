<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>SneakyBaseball</AssemblyName>
    <RootNamespace>SneakyBaseball</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- 런타임을 담지 않는다. WebSwing 윈도우 빌드와 같은 방식이라 파일이 작다. -->
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!-- 게임 코드(src/)를 그대로 실어 나른다. 빌드 단계에서 손대지 않는다. -->
  <ItemGroup>
    <Content Include="..\src\game\**\*.js" Link="web\game\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\src\render\**\*.js" Link="web\render\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\src\renderer\**\*.*" Link="web\renderer\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
